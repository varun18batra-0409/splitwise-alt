{
  "name": "splitwise-alt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run db:setup",
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "db:setup": "prisma db push && node prisma/upgrade-data.mjs",
    "postinstall": "prisma generate",
    "share": "gh codespace ports visibility 3000:public -c \"$CODESPACE_NAME\" && echo \"✓ The app address is public: invite links now work for friends.\" || echo \"Could not make the address public automatically. In the Ports tab, long-press port 3000 → Port Visibility → Public.\"",
    "vercel-build": "node scripts/turso-sync.mjs && node prisma/upgrade-data.mjs && node scripts/fetch-photos.mjs && next build",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report e2e-report"
  },
  "dependencies": {
    "@prisma/client": "^6.8.0",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@prisma/adapter-libsql": "^6.8.0",
    "@libsql/client": "^0.15.0",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "nodemailer": "^6.9.16",
    "@simplewebauthn/server": "^13.1.1",
    "@simplewebauthn/browser": "^13.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prisma": "^6.8.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0",
    "@types/qrcode": "^1.5.5",
    "@types/web-push": "^3.6.4",
    "@types/nodemailer": "^6.4.17",
    "@playwright/test": "^1.51.1"
  }
}
