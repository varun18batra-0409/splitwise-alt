// Database design. All money is stored as whole numbers in the currency's
// smallest unit (₹12.50 = 1250 paise; THB 3,000 = 300000 satang; ¥500 = 500).
//
// Every new column has a default, so `prisma db push` adds them to an existing
// database without touching saved data. prisma/upgrade-data.mjs then fills in
// the right values for expenses saved before multi-currency existed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Group {
  id         String    @id @default(cuid())
  name       String
  currency     String    @default("INR") // base settlement currency: balances are shown in this
  cardMarkupBp Int       @default(0) // foreign card markup default, hundredths of a % (300 = 3%)
  secondaryCurrency String @default("") // also show amounts in this: "" = the foreign currency used most, "none" = off
  closed       Boolean   @default(false) // closed groups are hidden from the main list and read-only for new expenses
  closedAt     DateTime?
  inviteCode   String    @unique
  createdAt  DateTime  @default(now())
  members    Member[]
  expenses   Expense[]
  payments   Payment[]
  events     GroupEvent[]
}

model Member {
  id        String   @id @default(cuid())
  name      String
  phone     String   @default("") // from the phone's contacts, if they were added that way
  seenEventsAt DateTime? // notifications newer than this are unread for this person (empty = since they joined)
  leftAt    DateTime? // set when they left the group: kept in history, not offered for new expenses
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  paid         Expense[]      @relation("PaidBy")
  shares       ExpenseShare[]
  paymentsSent Payment[]      @relation("PaymentFrom")
  paymentsRecv Payment[]      @relation("PaymentTo")

  @@unique([groupId, name])
}

model Expense {
  id          String         @id @default(cuid())
  groupId     String
  group       Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  description String
  amount      Int // FINAL total in the group's currency (converted + markup). Shares add up to this.
  splitType   String // "equal" | "exact" | "percent"
  forMode     String         @default("everyone") // who it was for: "everyone" | "selected" | "one"
  category    String         @default("other") // e.g. "food", "transport"

  // Currency details, frozen when the expense is saved so later rate changes never alter it.
  originalAmount   Int    @default(0) // in the original currency's smallest unit
  originalCurrency String @default("INR")
  baseCurrency     String @default("INR") // group currency at the time
  exchangeRate     String @default("1") // exact text, e.g. "2.8367" = 1 original → 2.8367 base
  rateDate         String @default("") // date the rate applies to, e.g. "2026-10-14"
  rateSource       String @default("same") // "same" (no conversion) | "api" | "manual"
  convertedAmount  Int    @default(0) // original × rate, in base currency
  paymentMethod    String @default("") // "card" | "cash" | "bank"; "" when no conversion
  markupBp         Int    @default(0) // card markup applied, hundredths of a % (300 = 3%)
  markupAmount     Int    @default(0) // markup in base currency

  paidById    String
  paidBy      Member         @relation("PaidBy", fields: [paidById], references: [id])
  createdAt   DateTime       @default(now())
  shares      ExpenseShare[] // one line per person; receipt items can hang off this later

  spentAt     DateTime? // the day it was spent (chosen when adding); empty = the day it was added
  createdById String    @default("") // who added it
  editedAt    DateTime? // last time it was changed
  deletedAt   DateTime? // deleted expenses stay in history but no longer count
  deletedById String?
}

model ExpenseShare {
  id        String  @id @default(cuid())
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member  @relation(fields: [memberId], references: [id])
  amount    Int // this person's share, in paise
}

// A record that one person paid another back. The app never moves real money.
model Payment {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromId    String
  from      Member   @relation("PaymentFrom", fields: [fromId], references: [id])
  toId      String
  to        Member   @relation("PaymentTo", fields: [toId], references: [id])
  amount    Int // in the group's currency
  createdAt DateTime @default(now())

  createdById String    @default("") // who recorded it
  deletedAt   DateTime? // deleted payments stay in history but no longer count
  deletedById String?
}

// Everything that happens in a group: the change history and the source of
// notifications. Each person sees events by others since they last looked.
model GroupEvent {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  actorId   String // member who did it
  kind      String // expense_added | expense_edited | expense_deleted | expense_restored | payment_recorded | payment_deleted | group_renamed | currency_changed | markup_changed | members_added | group_closed | group_reopened
  text      String // ready-to-show summary, e.g. "added Dinner (₹900)"
  details   String   @default("[]") // JSON list of changes, e.g. ["Amount: ₹900 → ₹1,200"]
  expenseId String?
  paymentId String?
  undo      String   @default("") // JSON describing how to reverse this change ("" = can't be undone)
  undoneAt  DateTime? // set once someone undoes it
  undoneById String?
  createdAt DateTime @default(now())

  @@index([groupId, createdAt])
}

// Cache of exchange rates fetched from frankfurter.dev, so we call it rarely.
// Expenses keep their own copy of the rate they used; this table is only a cache.
model ExchangeRate {
  id        String   @id @default(cuid())
  base      String // e.g. "THB"
  quote     String // e.g. "INR"
  rate      String // exact text, e.g. "2.8367"
  date      String // the date the rate applies to
  fetchedAt DateTime @default(now())

  @@index([base, quote, fetchedAt])
}
