// Database design. All money is stored as whole numbers in the currency's
// smallest unit (₹12.50 = 1250 paise; THB 3,000 = 300000 satang; ¥500 = 500).
//
// Every new column has a default, so `prisma db push` adds them to an existing
// database without touching saved data. prisma/upgrade-data.mjs then fills in
// the right values for expenses saved before multi-currency existed.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"] // lets the hosted app use Turso (online SQLite)
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Group {
  id         String    @id @default(cuid())
  name       String
  currency     String    @default("INR") // base settlement currency: balances are shown in this
  cardMarkupBp Int       @default(0) // foreign card markup default, hundredths of a % (300 = 3%)
  secondaryCurrency String @default("") // also show amounts in this: "" = the foreign currency used most, "none" = off
  closed       Boolean   @default(false) // closed groups are hidden from the main list and read-only for new expenses
  closedAt     DateTime?
  deletedAt    DateTime? // "Delete group": hidden for everyone, restorable for 30 days, then removed for good
  deletedById  String    @default("")
  inviteCode   String    @unique
  createdAt  DateTime  @default(now())
  members    Member[]
  expenses   Expense[]
  payments   Payment[]
  events     GroupEvent[]

  // Added later: kept at the end so the online database can simply add the columns.
  type         String    @default("other") // "trip" | "home" | "couple" | "other": sets defaults only
  joinWeight   Int       @default(100) // split weight given to people who join (a couple's 55/45 → 45)
  reminders    Boolean   @default(false) // Home groups: bill and settle-up reminders (off until switched on)
  settleDay    Int       @default(0) // monthly settle-up day: 0 = none, 1–28, 31 = last day
  settleMin    Int       @default(0) // Smart Settle leaves out payments smaller than this (minor units)
  cover        String    @default("") // the group's picture: "" = picked from the type, "plain" = none (see covers.ts)
  coverAt      DateTime? // when the group's own photo was last uploaded (its version); empty = no own photo
  tripStart    String    @default("") // trip groups: first day "YYYY-MM-DD" (the countdown); "" = not set
  tripEnd      String    @default("") // trip groups: last day; "" = same as the start
  tripPlace    String    @default("") // trip groups: where to ("Goa", "Bangkok, Phuket"); "" = guessed from the name
  tripCountry  String    @default("") // trip groups: the country (ISO code, "IN"); "" = guessed

  bills      Bill[]
  listItems  ListItem[]
  budgets    Budget[]
  goals      Goal[]
  deposit    Deposit?
}

model Member {
  id        String   @id @default(cuid())
  name      String
  phone     String   @default("") // from the phone's contacts, if they were added that way
  seenEventsAt DateTime? // notifications newer than this are unread for this person (empty = since they joined)
  leftAt    DateTime? // set when they left the group: kept in history, not offered for new expenses
  claimedAt DateTime? // when someone on a phone picked this name (null = added by name, not joined yet)
  // Set when the person signed in with email, so their groups follow them to any
  // phone. A plain id (no database link) so the hosted database can add it as a
  // simple new column; deleting an account clears it in code.
  accountId String?
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  paid         Expense[]      @relation("PaidBy")
  shares       ExpenseShare[]
  paymentsSent Payment[]      @relation("PaymentFrom")
  paymentsRecv Payment[]      @relation("PaymentTo")
  pushSubscriptions PushSubscription[]


  // Added later: kept at the end so the online database can simply add the columns.
  notify    String   @default("") // phone notifications for this group: JSON {off, expenses, edits, payments, people}; "" = all on
  splitWeight Int    @default(100) // the group's own split: hundredths of a share (1.2 shares = 120; a couple's 55/45 = 55)
  joinedFrom  DateTime? // moved in mid-month: their first month's bills are shared from this day
  @@unique([groupId, name])
  @@index([accountId])
}

model Expense {
  id          String         @id @default(cuid())
  groupId     String
  group       Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  description String
  notes       String    @default("") // optional free text, e.g. "Rahul paid the tip separately"
  amount      Int // FINAL total in the group's currency (converted + markup). Shares add up to this.
  splitType   String // "equal" | "exact" | "percent"
  forMode     String         @default("everyone") // who it was for: "everyone" | "selected" | "one"
  category    String         @default("other") // e.g. "food", "transport"

  // Currency details, frozen when the expense is saved so later rate changes never alter it.
  originalAmount   Int    @default(0) // in the original currency's smallest unit
  originalCurrency String @default("INR")
  baseCurrency     String @default("INR") // group currency at the time
  exchangeRate     String @default("1") // exact text, e.g. "2.8367" = 1 original → 2.8367 base
  rateDate         String @default("") // date the rate applies to, e.g. "2026-10-14"
  rateSource       String @default("same") // "same" (no conversion) | "api" | "manual"
  convertedAmount  Int    @default(0) // original × rate, in base currency
  paymentMethod    String @default("") // "card" | "cash" | "bank"; "" when no conversion
  markupBp         Int    @default(0) // card markup applied, hundredths of a % (300 = 3%)
  markupAmount     Int    @default(0) // markup in base currency

  paidById    String // the payer (with several, the one who paid most)
  paidBy      Member         @relation("PaidBy", fields: [paidById], references: [id])
  createdAt   DateTime       @default(now())
  shares      ExpenseShare[] // one line per person; receipt items can hang off this later

  spentAt     DateTime? // the day it was spent (chosen when adding); empty = the day it was added
  createdById String    @default("") // who added it
  editedAt    DateTime? // last time it was changed
  deletedAt   DateTime? // deleted expenses stay in history but no longer count
  deletedById String?

  // Added later: kept at the end so the online database can simply add the columns.
  payers      String         @default("") // more than one payer: JSON [{"m": memberId, "a": paise}] adding up to amount; "" = just paidById
  kind        String         @default("expense") // "expense" | "refund" (money back: whoever got it owes the people it's shared with)
  @@index([groupId])
}

model ExpenseShare {
  id        String  @id @default(cuid())
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member  @relation(fields: [memberId], references: [id])
  amount    Int // this person's share, in paise
  @@index([expenseId])
  @@index([memberId])
}

// A record that one person paid another back. The app never moves real money.
model Payment {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromId    String
  from      Member   @relation("PaymentFrom", fields: [fromId], references: [id])
  toId      String
  to        Member   @relation("PaymentTo", fields: [toId], references: [id])
  amount    Int // in the group's currency
  createdAt DateTime @default(now())

  createdById String    @default("") // who recorded it
  deletedAt   DateTime? // deleted payments stay in history but no longer count
  deletedById String?
  // Payment tracking: recorded by someone other than the person paid, it waits
  // for them to tap "Got it" (okAt) or "Not received" (the payment is removed).
  needsOk     Boolean   @default(false)
  okAt        DateTime?
  @@index([groupId])
}

// Everything that happens in a group: the change history and the source of
// notifications. Each person sees events by others since they last looked.
model GroupEvent {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  actorId   String // member who did it
  kind      String // expense_added | expense_edited | expense_deleted | expense_restored | payment_recorded | payment_deleted | group_renamed | currency_changed | markup_changed | members_added | group_closed | group_reopened
  text      String // ready-to-show summary, e.g. "added Dinner (₹900)"
  details   String   @default("[]") // JSON list of changes, e.g. ["Amount: ₹900 → ₹1,200"]
  expenseId String?
  paymentId String?
  undo      String   @default("") // JSON describing how to reverse this change ("" = can't be undone)
  undoneAt  DateTime? // set once someone undoes it
  undoneById String?
  createdAt DateTime @default(now())

  @@index([groupId, createdAt])
  @@index([expenseId])
  @@index([paymentId])
}

// Cache of exchange rates fetched from frankfurter.dev, so we call it rarely.
// Expenses keep their own copy of the rate they used; this table is only a cache.
model ExchangeRate {
  id        String   @id @default(cuid())
  base      String // e.g. "THB"
  quote     String // e.g. "INR"
  rate      String // exact text, e.g. "2.8367"
  date      String // the date the rate applies to
  fetchedAt DateTime @default(now())

  @@index([base, quote, fetchedAt])
}

// A phone that turned on notifications, for one of the people it's signed in as.
model PushSubscription {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@unique([memberId, endpoint])
  @@index([memberId])
}

// Small app-wide settings (e.g. the keys used to sign push notifications).
model AppSetting {
  key   String @id
  value String
}

// Optional sign-in: an email address, so your groups follow you to any phone.
model Account {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String   @default("") // shown to friends when they search for you
  createdAt DateTime @default(now())
  collectPush Boolean @default(true) // phone notifications about collections (added, reminders, payments checked)
  // How friends pay you back: shown on Settle up to people in your groups who owe you.
  upiId     String   @default("") // e.g. asha@okicici (opens GPay / PhonePe with the amount filled in)
  payLink   String   @default("") // PayPal.me, Venmo, Cash App, Revolut or Monzo link
  // Trip passport: home country (ISO code; "" = from where you use Loopin) and
  // places you've been before Loopin, added by hand: JSON [{ c: "TH", city: "Phuket" }].
  homeCountry String @default("")
  places      String @default("[]")
}

// Notifications for a person rather than a group (Collect: "Asha added you",
// "Ravi says they paid"). Shown in Alerts; also sent to the phone if wanted.
model AccountNote {
  id        String    @id @default(cuid())
  accountId String
  kind      String // "collect_added" | "collect_reminder" | "collect_paid" | "collect_ticked"
  title     String
  body      String
  url       String
  seenAt    DateTime?
  createdAt DateTime  @default(now())
  @@index([accountId, createdAt])
}

// An email invitation to a group. The person becomes a member only after they
// verify that email (sign up / sign in) and accept.
model Invite {
  id          String    @id @default(cuid())
  groupId     String
  email       String
  invitedById String
  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?

  @@unique([groupId, email])
}

// Emails that would have been sent, kept instead of sending when MAIL_OUTBOX=1
// (only in automated tests).
model Outbox {
  id        String   @id @default(cuid())
  to        String
  subject   String
  text      String
  createdAt DateTime @default(now())
}

// One-time sign-in codes sent by email (stored hashed, valid 15 minutes).
model LoginCode {
  id        String    @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

// Simple request counters to stop spam (fixed time windows).
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

// Server errors, kept so problems are visible on the private stats page.
model ErrorLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  path      String   @default("")
  message   String
  digest    String   @default("")
}

// Makes saving safe to retry: each form carries a one-time key, saved in the
// same transaction as the change. A repeat of the same request (double tap,
// slow network, browser retry) finds the key and does nothing new.
model RequestKey {
  key       String   @id
  result    String   @default("")
  createdAt DateTime @default(now())
  @@index([createdAt])
}

// ---------- Home & Couple groups ----------

// A bill that repeats: added automatically (fixed), or the payer is asked
// for the amount (varies), or tallied daily and added at month end (daily).
model Bill {
  id          String    @id @default(cuid())
  groupId     String
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name        String
  category    String    @default("bills")
  icon        String    @default("other") // which tile it came from
  nature      String    @default("fixed") // "fixed" | "varies" | "daily"
  amount      Int       @default(0) // fixed: the amount; daily: per day; varies: the last amount (for "usually")
  day         Int       @default(1) // day of the month it's due: 1–28, or 31 = the last day
  every       Int       @default(1) // every N months
  payer       String    @default("") // memberId, or "" = take turns (rotation)
  rotation    String    @default("[]") // JSON memberIds, when taking turns
  split       String    @default("{\"mode\":\"group\"}") // JSON: {"mode":"group"|"equal"|"some","ids":[...]}
  startMonth  String // "2026-10"
  endMonth    String    @default("") // "" = no end
  paused      Boolean   @default(false)
  missed      String    @default("{}") // daily bills: JSON {"2026-10":[4,12]} days it didn't come
  tz          String    @default("Asia/Kolkata")
  createdById String    @default("")
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  runs        BillRun[]
  pausedAt    DateTime? // when it was paused (resuming skips what came round since)
  @@index([groupId])
}

// One bill in one period: added, waiting for its amount, or skipped. The
// unique (bill, period) pair is what makes adding it twice impossible.
model BillRun {
  id        String   @id @default(cuid())
  billId    String
  bill      Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  period    String // "2026-11"
  status     String // "added" | "waiting" | "skipped" | "adding" (being added right now)
  expenseId  String    @default("")
  reason     String    @default("")
  createdAt  DateTime  @default(now())
  claimedAt  DateTime? // when it was last set to "adding" (a stale claim is taken over)
  requestKey String    @default("") // "Enter amount": the key of the form that's adding it
  @@unique([billId, period])
}

model ListItem {
  id         String    @id @default(cuid())
  groupId    String
  group      Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  text       String
  addedById  String    @default("")
  boughtById String    @default("")
  boughtAt   DateTime?
  expenseId  String    @default("") // set once it's been added as an expense (then it's archived)
  createdAt  DateTime  @default(now())
  @@index([groupId])
}

model Budget {
  id       String @id @default(cuid())
  groupId  String
  group    Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  category String
  amount   Int // per month, minor units
  @@unique([groupId, category])
}

// A savings goal: kept count of only — the money stays in people's own accounts.
model Goal {
  id          String      @id @default(cuid())
  groupId     String
  group       Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name        String
  target      Int
  byDate      String      @default("") // "2027-03-15"
  createdById String      @default("")
  createdAt   DateTime    @default(now())
  reachedAt   DateTime?
  deletedAt   DateTime?
  entries     GoalEntry[]
  @@index([groupId])
}

model GoalEntry {
  id        String   @id @default(cuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  memberId  String
  amount    Int
  createdAt DateTime @default(now())
  @@index([goalId])
}

// The flat's security deposit: who put in what. Never part of balances.
model Deposit {
  id        String         @id @default(cuid())
  groupId   String         @unique
  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  heldBy    String         @default("Landlord")
  createdAt DateTime       @default(now())
  shares    DepositShare[]
}

model DepositShare {
  id         String   @id @default(cuid())
  depositId  String
  deposit    Deposit  @relation(fields: [depositId], references: [id], onDelete: Cascade)
  memberId   String
  amount     Int
  status     String   @default("held") // "held" | "returned" | "transferred"
  toMemberId String   @default("") // transferred: who took it over
  updatedAt  DateTime @default(now())
  returnedAmount Int  @default(0) // returned: what they actually got back (after deductions)
  @@unique([depositId, memberId])
}

// Things sent automatically at most once (reminders, budget alerts, the
// monthly summary, "going shopping"): the key says what, for whom and when.
model NotifyLog {
  key       String   @id
  createdAt DateTime @default(now())
}

// How long things take on people's phones (numbers only: the kind of step,
// the screen's shape with ids removed, and milliseconds). Kept 14 days.
model SpeedLog {
  id    String   @id @default(cuid())
  at    DateTime @default(now())
  kind  String // "nav" (tap → next screen) | "submit" (form → next screen) | "search" | "load" (opening the app)
  route String // "/groups/:id/invite"
  ms    Int
  @@index([at])
}

// Fingerprint / face sign-in (passkeys). The private key never leaves the
// person's phone; we keep only the public key to check signatures.
model Passkey {
  id         String    @id // the credential id (base64url)
  accountId  String
  publicKey  String // base64url
  counter    Int       @default(0)
  transports String    @default("") // comma-separated hints, e.g. "internal,hybrid"
  label      String    @default("") // "Android phone", "iPhone"…
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  @@index([accountId])
}

// A group's own photo (picked on a phone, made small there first: about
// 100–300 KB). Shown only to people in the group. One per group; a new one
// replaces it. A plain id (no database link) so the online database can
// simply add the table.
model GroupPhoto {
  groupId     String   @id
  data        Bytes
  type        String   @default("image/webp")
  createdById String   @default("")
  updatedAt   DateTime @default(now())
}

// "Collect": one person gathers money from many (a class gift, a farewell,
// club fees). Everyone pays the organiser directly (UPI or their usual app);
// Loopin only keeps the list of who has paid. The link's code is hard to guess.
model Collection {
  id          String    @id @default(cuid())
  code        String    @unique
  title       String
  note        String    @default("")
  currency    String    @default("INR")
  amount      Int       @default(0) // per person, smallest units; 0 = any amount
  dueDate     String    @default("") // "2026-11-01" or ""
  upiId       String    @default("") // where to pay (INR)
  payLink     String    @default("") // a PayPal.me / Venmo / Revolut link (other currencies)
  accountId   String // the organiser
  organiser   String // the organiser's name, as shown to payers
  closedAt    DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  entries     CollectionEntry[]
  @@index([accountId])
}

// One person on a collection's list: someone the organiser expects ("due"),
// someone who says they've paid ("paid"), or paid and checked by the organiser ("confirmed").
model CollectionEntry {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  name         String
  amount       Int        @default(0) // what they paid (smallest units); 0 while due
  status       String     @default("due") // "due" | "paid" | "confirmed"
  method       String     @default("") // "upi" | "cash" | "other"
  payerKey     String     @default("") // the payer's phone, so they can see and undo their own entry
  paidAt       DateTime?
  confirmedAt  DateTime?
  createdAt    DateTime   @default(now())
  phone        String     @default("") // from the organiser's contacts, for a WhatsApp reminder; only the organiser sees it
  accountId    String     @default("") // a Loopin user: gets in-app notifications (added, reminded, payment checked)
  @@index([collectionId])
}

// "The Pot": card nights (Poker, Teen Patti). Players take money from a shared
// pot, play, and put back what they have left; the difference is each one's
// win or loss. Only the money in and out is kept (no chips, bets or hands).
// When the game is finished its result goes into the group's balances as one
// line (an expense of kind "pot"), so settling up works as for any group.
model PotGame {
  id          String    @id @default(cuid())
  groupId     String
  name        String
  game        String    @default("teenpatti") // "poker" | "teenpatti"
  players     String    @default("[]") // JSON list of member ids playing this game
  hostId      String // the member who started it: finishes, adjusts, reopens
  status      String    @default("open") // "open" | "done"
  resultId    String    @default("") // the result line in the group's balances ("" while open)
  finishedAt  DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  moves       PotMove[]
  @@index([groupId])
}

// Money taken from the pot, put back, or an adjustment the host made (with a reason).
model PotMove {
  id          String    @id @default(cuid())
  gameId      String
  game        PotGame   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  memberId    String // whose money it is
  kind        String // "take" | "return" | "adjust"
  amount      Int // smallest units; take/return > 0, adjust can be minus
  note        String    @default("")
  createdById String // who recorded it
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  @@index([gameId])
}

// Reactions on an expense (😂 🔥 😭 🙄 …): one per person per expense.
model Reaction {
  id        String   @id @default(cuid())
  expenseId String
  memberId  String
  emoji     String
  createdAt DateTime @default(now())
  @@unique([expenseId, memberId])
  @@index([expenseId])
}
