{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "fluid": true,
  "regions": [
    "bom1"
  ],
  "git": {
    "deploymentEnabled": {
      "screenshots": false,
      "screenshots-*": false,
      "schema-plan": false,
      "phase*": false,
      "speed-report": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/evening",
      "schedule": "0 16 * * *"
    }
  ]
}
